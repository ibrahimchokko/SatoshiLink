# Copy to .env.local and fill in real values from Polar.
# Keep this file checked in; keep secrets out of source control.

LND_REST_HOST=https://127.0.0.1:8081
LND_TLS_SERVERNAME=localhost
LND_TLS_CERT_PATH=/absolute/path/to/tls.cert
LND_MACAROON_PATH=/absolute/path/to/admin.macaroon

# Alternative inline form if file paths are awkward:
# LND_TLS_CERT_BASE64=
# LND_MACAROON_HEX=

NEXT_PUBLIC_APP_NAME=SatoshiLink
FREELANCER_NAME=Amina

# Optional: if you want the browser wallet mode to be available in production
# see docs/DEPLOY-VERCEL.md.
